generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String           @id @default(uuid())
  email           String           @unique
  displayName     String
  monthlyBudget   Float            @default(0)
  startingBalance Float            @default(0)
  preferences     String           @default("{\"theme\": \"dark\", \"currency\": \"EUR\", \"active_mode\": \"all\"}")
  createdAt       DateTime         @default(now())
  subjects        Subject[]
  tasks           Task[]
  savingsPots     SavingsPot[]
  transactions    Transaction[]
  widgets         UserWidget[]
  schedule        ScheduleBlock[]
  reminders       Reminder[]
  notes           Note[]
  untisConfig     WebUntisConfig?
  bankingConfig   BankingConfig?
  bankConnections BankConnection[]
  bankAccounts    BankAccount[]
  exams           Exam[]
  grades          Grade[]
  shoppingItems   ShoppingItem[]
  habits          Habit[]
  birthdays       Birthday[]
  categoryBudgets CategoryBudget[]
  categoryRules   CategoryRule[]
  skills          Skill[]
  bibleBookmarks  BibleBookmark[]
}

model WebUntisConfig {
  id             String    @id @default(uuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  school         String    @default("gym-st-michael")
  schoolName     String    @default("Gymnasium St. Michael")
  server         String    @default("arche.webuntis.com")
  username       String    @default("alexander.student")
  password       String?
  icalUrl        String?
  isConnected    Boolean   @default(true)
  lastSyncAt     DateTime?
  autoSync       Boolean   @default(true)
  /// personal = the student's own timetable, class = the whole class incl. parallel groups
  timetableScope String    @default("personal")
  /// JSON array of studentGroup tags (see ScheduleBlock.studentGroup) that belong to this user,
  /// e.g. ["1"] for "Gruppe 1" or ["PM-UI"] for a Schwerpunkt. Empty = show every group.
  selectedGroups String    @default("[]")
  /// JSON array of lesson keys (day|start|subject|group) the user does not attend – used for
  /// the parallel slots WebUntis leaves untagged, where only the student knows their half.
  hiddenLessons  String    @default("[]")
  /// JSON array of { keys, anchorMonday, anchorKey } for slots that alternate week by week
  /// (e.g. SENCYB: one week Weixlbaum, the next Schreiber).
  rotatingLessons String   @default("[]")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

/// Enable Banking API application credentials (PSD2 account information).
model BankingConfig {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  appId       String?
  privateKey  String?
  redirectUrl String?
  updatedAt   DateTime @updatedAt
}

/// One bank authorisation (session) at Enable Banking, valid until the consent expires.
model BankConnection {
  id           String        @id @default(uuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  aspspName    String
  aspspCountry String
  authState    String?       @unique
  sessionId    String?
  validUntil   DateTime?
  status       String        @default("pending") // pending | active | expired | error
  lastSyncAt   DateTime?
  lastError    String?
  createdAt    DateTime      @default(now())
  accounts     BankAccount[]
}

/// A bank or broker account – synced live or filled by file imports.
model BankAccount {
  id                String          @id @default(uuid())
  userId            String
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectionId      String?
  connection        BankConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  source            String // enablebanking | george | traderepublic | finanzguru | file
  externalKey       String
  providerAccountId String?
  name              String
  iban              String?
  currency          String          @default("EUR")
  balance           Float?
  balanceUpdatedAt  DateTime?
  includeInBalance  Boolean         @default(true)
  lastImportAt      DateTime?
  createdAt         DateTime        @default(now())
  transactions      Transaction[]

  @@unique([userId, externalKey])
}

model Subject {
  id        String          @id @default(uuid())
  userId    String?
  user      User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  untisCode String?
  colorHex  String          @default("#6366f1")
  icon      String          @default("book")
  createdAt DateTime        @default(now())
  tasks     Task[]
  lessons   ScheduleBlock[]
  exams     Exam[]
  grades    Grade[]
}

model Task {
  id               String         @id @default(uuid())
  userId           String?
  user             User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId        String?
  subject          Subject?       @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  scheduleBlockId  String?
  scheduleBlock    ScheduleBlock? @relation(fields: [scheduleBlockId], references: [id], onDelete: SetNull)
  title            String
  description      String?
  dueDate          DateTime
  estimatedMinutes Int            @default(30)
  priority         String         @default("medium")
  status           String         @default("backlog")
  isUntisSync      Boolean        @default(false)
  customMetadata   String?        @default("{}")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

/// Schularbeiten, Tests, Referate … with a countdown.
model Exam {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId String?
  subject   Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  title     String
  kind      String   @default("test") // schularbeit | test | pruefung | referat | sonstiges
  date      DateTime
  /// Free-text notes; the checklist lives in topicItems below.
  topics    String?
  isDone    Boolean  @default(false)
  /// Set by the WebUntis sync (lesson type "ex") so a re-sync updates instead of duplicating.
  isUntisSync     Boolean     @default(false)
  externalUntisId String?
  createdAt DateTime @default(now())
  topicItems ExamTopic[]

  @@unique([userId, externalUntisId])
}

/// Bible text cached from getbible.net, so reading stays fast and works offline.
model BibleBook {
  id           String   @id @default(uuid())
  translation  String
  bookNr       Int
  name         String
  chapterCount Int
  fetchedAt    DateTime @default(now())

  @@unique([translation, bookNr])
}

model BibleChapter {
  id          String   @id @default(uuid())
  translation String
  bookNr      Int
  chapter     Int
  /// JSON array of { verse, text }
  verses      String

  @@unique([translation, bookNr, chapter])
}

/// A verse the user saved, with an optional note.
model BibleBookmark {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  translation String
  bookNr      Int
  bookName    String
  chapter     Int
  verse       Int
  text        String
  note        String?
  createdAt   DateTime @default(now())

  @@unique([userId, bookNr, chapter, verse])
}

/// One checkable item of exam material ("Stoff"), e.g. a chapter or topic.
model ExamTopic {
  id        String   @id @default(uuid())
  examId    String
  exam      Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  title     String
  isDone    Boolean  @default(false)
  position  Int      @default(0)
  createdAt DateTime @default(now())
}

/// Austrian grades 1 (Sehr gut) – 5 (Nicht genügend), weighted per kind.
model Grade {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId String?
  subject   Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  value     Float
  kind      String   @default("test") // schularbeit | test | mitarbeit | sonstiges
  weight    Float    @default(1)
  title     String?
  date      DateTime @default(now())
  createdAt DateTime @default(now())
}

model ShoppingItem {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  quantity  String?
  isDone    Boolean   @default(false)
  doneAt    DateTime?
  createdAt DateTime  @default(now())
}

model Habit {
  id        String     @id @default(uuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  emoji     String     @default("✅")
  archived  Boolean    @default(false)
  createdAt DateTime   @default(now())
  logs      HabitLog[]
}

model HabitLog {
  id      String @id @default(uuid())
  habitId String
  habit   Habit  @relation(fields: [habitId], references: [id], onDelete: Cascade)
  /// Local calendar day, yyyy-MM-dd
  day     String

  @@unique([habitId, day])
}

model Birthday {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  month     Int
  day       Int
  year      Int?
  note      String?
  createdAt DateTime @default(now())
}

/// Monthly spending limit per category.
model CategoryBudget {
  id       String @id @default(uuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  category String
  limit    Float

  @@unique([userId, category])
}

/// Remembered category for a merchant, applied to future imports.
model CategoryRule {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Normalised merchant key (see lib/finance/merchant.ts)
  pattern   String
  category  String
  createdAt DateTime @default(now())

  @@unique([userId, pattern])
}

/// Something the user wants to learn.
model Skill {
  id            String          @id @default(uuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  emoji         String          @default("🎯")
  category      String          @default("Sonstiges")
  /// idea | active | paused | done
  status        String          @default("idea")
  why           String?
  weeklyMinutes Int             @default(60)
  targetDate    DateTime?
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime        @default(now())
  steps         SkillStep[]
  resources     SkillResource[]
  sessions      SkillSession[]
}

model SkillStep {
  id        String   @id @default(uuid())
  skillId   String
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  title     String
  isDone    Boolean  @default(false)
  position  Int      @default(0)
  createdAt DateTime @default(now())
}

model SkillResource {
  id        String   @id @default(uuid())
  skillId   String
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  title     String
  url       String?
  /// video | course | book | app | article | other
  kind      String   @default("other")
  isDone    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model SkillSession {
  id      String   @id @default(uuid())
  skillId String
  skill   Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  minutes Int
  date    DateTime @default(now())
  note    String?

  @@index([skillId, date])
}

model ScheduleBlock {
  id               String   @id @default(uuid())
  userId           String?
  user             User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId        String?
  subject          Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  title            String
  subjectCode      String?
  dayOfWeek        Int      @default(1)
  startTime        String
  endTime          String
  room             String?
  teacher          String?
  colorHex         String   @default("#8B5CF6")
  isCancelled      Boolean  @default(false)
  substitutionNote String?
  externalUntisId  String?
  /// Raw WebUntis student-group tag ("sg"), or a fallback (teacher/room) when two parallel
  /// lessons of the same subject share a slot without one. Null = a lesson everyone attends.
  studentGroup     String?
  /// WebUntis lesson type "ex" – an exam gets mirrored into the Exam model automatically.
  isExam           Boolean  @default(false)
  createdAt        DateTime @default(now())
  tasks            Task[]
}

model Reminder {
  id            String    @id @default(uuid())
  userId        String?
  user          User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  category      String    @default("Haushalt")
  hasDueDate    Boolean   @default(true)
  dueDate       DateTime?
  dueTime       String?
  personName    String? // z. B. "Mama", "Hr. Weber", "Chris"
  reminderType  String    @default("todo") // "say_to_person", "action", "errand"
  isDone        Boolean   @default(false)
  icon          String    @default("bell")
  priority      String    @default("medium")
  repeatPattern String    @default("none")
  createdAt     DateTime  @default(now())
}

model Note {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  content   String
  category  String   @default("Gedanken") // "Gedanken", "Uni", "Ideen", "Wichtig"
  isPinned  Boolean  @default(false)
  colorHex  String   @default("#6366F1")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SavingsPot {
  id                  String        @id @default(uuid())
  userId              String?
  user                User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                String
  targetAmount        Float
  currentAmount       Float         @default(0.0)
  monthlyContribution Float         @default(0.0)
  targetDate          DateTime?
  icon                String        @default("piggy-bank")
  colorHex            String        @default("#10b981")
  isArchived          Boolean       @default(false)
  createdAt           DateTime      @default(now())
  transactions        Transaction[]
}

model Transaction {
  id              String       @id @default(uuid())
  userId          String?
  user            User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  savingsPotId    String?
  savingsPot      SavingsPot?  @relation(fields: [savingsPotId], references: [id], onDelete: SetNull)
  bankAccountId   String?
  bankAccount     BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  title           String
  amount          Float
  category        String
  type            String
  isRecurring     Boolean      @default(false)
  /// manual | enablebanking | george | traderepublic | finanzguru | file
  source          String       @default("manual")
  externalId      String?
  counterparty    String?
  description     String?
  transactionDate DateTime     @default(now())
  createdAt       DateTime     @default(now())

  @@unique([userId, externalId])
  @@index([userId, transactionDate])
}

model UserWidget {
  id             String   @id @default(uuid())
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  widgetKey      String
  title          String
  layoutPosition String   @default("{\"col\": 1, \"row\": 1, \"width\": 1, \"height\": 1}")
  config         String   @default("{}")
  isVisible      Boolean  @default(true)
  createdAt      DateTime @default(now())
}
