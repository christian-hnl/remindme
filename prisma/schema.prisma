generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String           @id @default(uuid())
  email           String           @unique
  displayName     String
  monthlyBudget   Float            @default(0)
  startingBalance Float            @default(0)
  preferences     String           @default("{\"theme\": \"dark\", \"currency\": \"EUR\", \"active_mode\": \"all\"}")
  createdAt       DateTime         @default(now())
  subjects        Subject[]
  tasks           Task[]
  savingsPots     SavingsPot[]
  transactions    Transaction[]
  widgets         UserWidget[]
  schedule        ScheduleBlock[]
  reminders       Reminder[]
  notes           Note[]
  untisConfig     WebUntisConfig?
  bankingConfig   BankingConfig?
  bankConnections BankConnection[]
  bankAccounts    BankAccount[]
  exams           Exam[]
  grades          Grade[]
  shoppingItems   ShoppingItem[]
  habits          Habit[]
  birthdays       Birthday[]
  categoryBudgets CategoryBudget[]
  categoryRules   CategoryRule[]
  skills          Skill[]
  bibleBookmarks  BibleBookmark[]
  vmmConfig       VmmConfig?
  nutrition       NutritionSettings?
  recipes         Recipe[]
  mealWeeks       MealWeek[]
  mealLogs        MealLog[]
  bodyMetrics     BodyMetric[]
}

model WebUntisConfig {
  id             String    @id @default(uuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  school         String    @default("gym-st-michael")
  schoolName     String    @default("Gymnasium St. Michael")
  server         String    @default("arche.webuntis.com")
  username       String    @default("alexander.student")
  password       String?
  icalUrl        String?
  isConnected    Boolean   @default(true)
  lastSyncAt     DateTime?
  autoSync       Boolean   @default(true)
  /// personal = the student's own timetable, class = the whole class incl. parallel groups
  timetableScope String    @default("personal")
  /// JSON array of studentGroup tags (see ScheduleBlock.studentGroup) that belong to this user,
  /// e.g. ["1"] for "Gruppe 1" or ["PM-UI"] for a Schwerpunkt. Empty = show every group.
  selectedGroups String    @default("[]")
  /// JSON array of lesson keys (day|start|subject|group) the user does not attend – used for
  /// the parallel slots WebUntis leaves untagged, where only the student knows their half.
  hiddenLessons  String    @default("[]")
  /// JSON array of { keys, anchorMonday, anchorKey } for slots that alternate week by week
  /// (e.g. SENCYB: one week Weixlbaum, the next Schreiber).
  rotatingLessons String   @default("[]")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

/// Enable Banking API application credentials (PSD2 account information).
model BankingConfig {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  appId       String?
  privateKey  String?
  redirectUrl String?
  updatedAt   DateTime @updatedAt
}

/// One bank authorisation (session) at Enable Banking, valid until the consent expires.
model BankConnection {
  id           String        @id @default(uuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  aspspName    String
  aspspCountry String
  authState    String?       @unique
  sessionId    String?
  validUntil   DateTime?
  status       String        @default("pending") // pending | active | expired | error
  lastSyncAt   DateTime?
  lastError    String?
  createdAt    DateTime      @default(now())
  accounts     BankAccount[]
}

/// A bank or broker account – synced live or filled by file imports.
model BankAccount {
  id                String          @id @default(uuid())
  userId            String
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectionId      String?
  connection        BankConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  source            String // enablebanking | george | traderepublic | finanzguru | file
  externalKey       String
  providerAccountId String?
  name              String
  iban              String?
  currency          String          @default("EUR")
  balance           Float?
  balanceUpdatedAt  DateTime?
  includeInBalance  Boolean         @default(true)
  lastImportAt      DateTime?
  createdAt         DateTime        @default(now())
  transactions      Transaction[]

  @@unique([userId, externalKey])
}

model Subject {
  id        String          @id @default(uuid())
  userId    String?
  user      User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  untisCode String?
  colorHex  String          @default("#6366f1")
  icon      String          @default("book")
  createdAt DateTime        @default(now())
  tasks     Task[]
  lessons   ScheduleBlock[]
  exams     Exam[]
  grades    Grade[]
}

model Task {
  id               String         @id @default(uuid())
  userId           String?
  user             User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId        String?
  subject          Subject?       @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  scheduleBlockId  String?
  scheduleBlock    ScheduleBlock? @relation(fields: [scheduleBlockId], references: [id], onDelete: SetNull)
  title            String
  description      String?
  dueDate          DateTime
  estimatedMinutes Int            @default(30)
  priority         String         @default("medium")
  status           String         @default("backlog")
  isUntisSync      Boolean        @default(false)
  customMetadata   String?        @default("{}")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

/// Schularbeiten, Tests, Referate … with a countdown.
model Exam {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId String?
  subject   Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  title     String
  kind      String   @default("test") // schularbeit | test | pruefung | referat | sonstiges
  date      DateTime
  /// Free-text notes; the checklist lives in topicItems below.
  topics    String?
  isDone    Boolean  @default(false)
  /// Set by the WebUntis sync (lesson type "ex") so a re-sync updates instead of duplicating.
  isUntisSync     Boolean     @default(false)
  externalUntisId String?
  createdAt DateTime @default(now())
  topicItems ExamTopic[]

  @@unique([userId, externalUntisId])
}

/// Connection to "View My Marks" (vmm.htlstp.ac.at), the school's grade portal.
/// It logs in with a link sent by mail, so what we keep is the session it hands back.
model VmmConfig {
  id         String    @id @default(uuid())
  userId     String    @unique
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  email      String?
  /// Django session cookie – never leaves the server.
  sessionId  String?
  csrfToken  String?
  username   String?
  role       String?
  lastSyncAt DateTime?
  lastError  String?
  updatedAt  DateTime  @updatedAt
  groups     VmmGroup[]
}

/// One subject/group in VMM with the marks it holds, cached for offline viewing.
model VmmGroup {
  id          String    @id @default(uuid())
  configId    String
  config      VmmConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  externalId  String
  name        String
  subjectName String?
  teacher     String?
  average     Float?
  /// Raw marks as VMM returns them, so nothing gets lost in translation.
  marks       String    @default("[]")
  updatedAt   DateTime  @updatedAt

  @@unique([configId, externalId])
}

/// Bible text cached from getbible.net, so reading stays fast and works offline.
model BibleBook {
  id           String   @id @default(uuid())
  translation  String
  bookNr       Int
  name         String
  chapterCount Int
  fetchedAt    DateTime @default(now())

  @@unique([translation, bookNr])
}

model BibleChapter {
  id          String   @id @default(uuid())
  translation String
  bookNr      Int
  chapter     Int
  /// JSON array of { verse, text }
  verses      String

  @@unique([translation, bookNr, chapter])
}

/// A verse the user saved, with an optional note.
model BibleBookmark {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  translation String
  bookNr      Int
  bookName    String
  chapter     Int
  verse       Int
  text        String
  note        String?
  createdAt   DateTime @default(now())

  @@unique([userId, bookNr, chapter, verse])
}

/// One checkable item of exam material ("Stoff"), e.g. a chapter or topic.
model ExamTopic {
  id        String   @id @default(uuid())
  examId    String
  exam      Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  title     String
  isDone    Boolean  @default(false)
  position  Int      @default(0)
  createdAt DateTime @default(now())
}

/// Austrian grades 1 (Sehr gut) – 5 (Nicht genügend), weighted per kind.
model Grade {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId String?
  subject   Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  value     Float
  kind      String   @default("test") // schularbeit | test | mitarbeit | sonstiges
  weight    Float    @default(1)
  title     String?
  date      DateTime @default(now())
  createdAt DateTime @default(now())
}

model ShoppingItem {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  quantity  String?
  /// Set when the meal plan put it there (e.g. "nutrition:2026-10-05"), so a new export can tidy up.
  sourceKey String?
  isDone    Boolean   @default(false)
  doneAt    DateTime?
  createdAt DateTime  @default(now())
}

model Habit {
  id        String     @id @default(uuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  emoji     String     @default("✅")
  archived  Boolean    @default(false)
  /// Set for routines another module ticks off by itself (e.g. "nutrition:prep").
  key       String?
  createdAt DateTime   @default(now())
  logs      HabitLog[]

  @@unique([userId, key])
}

model HabitLog {
  id      String @id @default(uuid())
  habitId String
  habit   Habit  @relation(fields: [habitId], references: [id], onDelete: Cascade)
  /// Local calendar day, yyyy-MM-dd
  day     String

  @@unique([habitId, day])
}

model Birthday {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  month     Int
  day       Int
  year      Int?
  note      String?
  createdAt DateTime @default(now())
}

/// Monthly spending limit per category.
model CategoryBudget {
  id       String @id @default(uuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  category String
  limit    Float

  @@unique([userId, category])
}

/// Remembered category for a merchant, applied to future imports.
model CategoryRule {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Normalised merchant key (see lib/finance/merchant.ts)
  pattern   String
  category  String
  createdAt DateTime @default(now())

  @@unique([userId, pattern])
}

/// Something the user wants to learn.
model Skill {
  id            String          @id @default(uuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  emoji         String          @default("🎯")
  category      String          @default("Sonstiges")
  /// idea | active | paused | done
  status        String          @default("idea")
  why           String?
  weeklyMinutes Int             @default(60)
  targetDate    DateTime?
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime        @default(now())
  steps         SkillStep[]
  resources     SkillResource[]
  sessions      SkillSession[]
}

model SkillStep {
  id        String   @id @default(uuid())
  skillId   String
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  title     String
  isDone    Boolean  @default(false)
  position  Int      @default(0)
  createdAt DateTime @default(now())
}

model SkillResource {
  id        String   @id @default(uuid())
  skillId   String
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  title     String
  url       String?
  /// video | course | book | app | article | other
  kind      String   @default("other")
  isDone    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model SkillSession {
  id      String   @id @default(uuid())
  skillId String
  skill   Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  minutes Int
  date    DateTime @default(now())
  note    String?

  @@index([skillId, date])
}

model ScheduleBlock {
  id               String   @id @default(uuid())
  userId           String?
  user             User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId        String?
  subject          Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  title            String
  subjectCode      String?
  dayOfWeek        Int      @default(1)
  startTime        String
  endTime          String
  room             String?
  teacher          String?
  colorHex         String   @default("#8B5CF6")
  isCancelled      Boolean  @default(false)
  substitutionNote String?
  externalUntisId  String?
  /// Raw WebUntis student-group tag ("sg"), or a fallback (teacher/room) when two parallel
  /// lessons of the same subject share a slot without one. Null = a lesson everyone attends.
  studentGroup     String?
  /// WebUntis lesson type "ex" – an exam gets mirrored into the Exam model automatically.
  isExam           Boolean  @default(false)
  createdAt        DateTime @default(now())
  tasks            Task[]
}

model Reminder {
  id            String    @id @default(uuid())
  userId        String?
  user          User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  category      String    @default("Haushalt")
  hasDueDate    Boolean   @default(true)
  dueDate       DateTime?
  dueTime       String?
  personName    String? // z. B. "Mama", "Hr. Weber", "Chris"
  reminderType  String    @default("todo") // "say_to_person", "action", "errand"
  isDone        Boolean   @default(false)
  icon          String    @default("bell")
  priority      String    @default("medium")
  repeatPattern String    @default("none")
  /// In-app target, e.g. "nutrition:shopping" – the reminder list shows an "Öffnen" button.
  link          String?
  /// Set for reminders a module keeps in sync by itself (e.g. "nutrition:prep:2026-10-04").
  sourceKey     String?
  createdAt     DateTime  @default(now())

  @@unique([userId, sourceKey])
}

model Note {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  content   String
  category  String   @default("Gedanken") // "Gedanken", "Uni", "Ideen", "Wichtig"
  isPinned  Boolean  @default(false)
  colorHex  String   @default("#6366F1")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SavingsPot {
  id                  String        @id @default(uuid())
  userId              String?
  user                User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                String
  targetAmount        Float
  currentAmount       Float         @default(0.0)
  monthlyContribution Float         @default(0.0)
  targetDate          DateTime?
  icon                String        @default("piggy-bank")
  colorHex            String        @default("#10b981")
  isArchived          Boolean       @default(false)
  createdAt           DateTime      @default(now())
  transactions        Transaction[]
}

model Transaction {
  id              String       @id @default(uuid())
  userId          String?
  user            User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  savingsPotId    String?
  savingsPot      SavingsPot?  @relation(fields: [savingsPotId], references: [id], onDelete: SetNull)
  bankAccountId   String?
  bankAccount     BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  title           String
  amount          Float
  category        String
  type            String
  isRecurring     Boolean      @default(false)
  /// manual | enablebanking | george | traderepublic | finanzguru | file
  source          String       @default("manual")
  externalId      String?
  counterparty    String?
  description     String?
  transactionDate DateTime     @default(now())
  createdAt       DateTime     @default(now())

  @@unique([userId, externalId])
  @@index([userId, transactionDate])
}

model UserWidget {
  id             String   @id @default(uuid())
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  widgetKey      String
  title          String
  layoutPosition String   @default("{\"col\": 1, \"row\": 1, \"width\": 1, \"height\": 1}")
  config         String   @default("{}")
  isVisible      Boolean  @default(true)
  createdAt      DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Ernährung / Meal Prep
// ---------------------------------------------------------------------------

/// Food with nutrition per 100 g and an estimated Hofer/Lidl price. Shared by all users.
model Ingredient {
  id         String             @id @default(uuid())
  slug       String             @unique
  name       String
  /// Store department, groups the shopping list.
  department String
  kcal       Float
  protein    Float
  carbs      Float
  fat        Float
  pricePerKg Float
  packGrams  Float
  packLabel  String
  pieceGrams Float?
  pieceLabel String?
  /// Lasts for weeks (oil, spices, honey) – checked, not bought every week.
  pantry     Boolean            @default(false)
  recipes    RecipeIngredient[]
}

/// Built-in recipes carry a slug (the seed upserts by it); the user's own have a userId.
model Recipe {
  id              String                  @id @default(uuid())
  slug            String?                 @unique
  userId          String?
  user            User?                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  /// breakfast | snack | main | preworkout | sauce
  mealType        String
  description     String                  @default("")
  flavorHack      String                  @default("")
  servings        Int                     @default(1)
  prepMinutes     Int                     @default(0)
  cookMinutes     Int                     @default(0)
  fridgeDays      Int                     @default(3)
  /// 0 = does not freeze well.
  freezerDays     Int                     @default(0)
  eatCold         Boolean                 @default(false)
  /// JSON string arrays
  tags            String                  @default("[]")
  equipment       String                  @default("[]")
  steps           String                  @default("[]")
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  ingredients     RecipeIngredient[]
  templateEntries MealPlanTemplateEntry[] @relation("TemplateRecipe")
  templateSauces  MealPlanTemplateEntry[] @relation("TemplateSauce")
  weekEntries     MealWeekEntry[]         @relation("WeekRecipe")
  weekSauces      MealWeekEntry[]         @relation("WeekSauce")
}

model RecipeIngredient {
  id           String     @id @default(uuid())
  recipeId     String
  recipe       Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  /// Grams for the whole recipe (all servings).
  grams        Float
  note         String?
  position     Int        @default(0)
}

/// One of the rotation weeks (Woche 1–4) the plan is built from.
model MealPlanTemplate {
  id          String                  @id @default(uuid())
  slug        String                  @unique
  number      Int
  name        String
  theme       String
  sauceBase   String
  /// midweek = mini prep on Wednesday, freeze = Thu/Fri portions go into the freezer
  strategy    String
  description String
  /// JSON array of prep steps (see lib/nutrition/catalog/templates.ts)
  prepSteps   String                  @default("[]")
  /// Fingerprint of the catalog in code when it was seeded – a change triggers a re-seed.
  catalogVersion String                @default("")
  entries     MealPlanTemplateEntry[]
  weeks       MealWeek[]
}

model MealPlanTemplateEntry {
  id         String           @id @default(uuid())
  templateId String
  template   MealPlanTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  /// ISO weekday, 1 = Monday
  day        Int
  slot       String
  /// Only for the afternoon slot: training | rest
  variant    String?
  recipeId   String
  recipe     Recipe           @relation("TemplateRecipe", fields: [recipeId], references: [id], onDelete: Cascade)
  sauceId    String?
  sauce      Recipe?          @relation("TemplateSauce", fields: [sauceId], references: [id], onDelete: SetNull)
}

/// The user's plan for one week (Monday = weekStart), copied from a rotation week and then adjusted.
model MealWeek {
  id         String            @id @default(uuid())
  userId     String
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Monday, yyyy-MM-dd
  weekStart  String
  templateId String?
  template   MealPlanTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  /// JSON array of prep step ids already done
  prepChecks String            @default("[]")
  /// "Einfach"-Woche: lunch and dinner are plain dishes (Huhn mit Reis & Co.) – shopping and prep follow.
  simple     Boolean           @default(false)
  /// Set once the week's shopping list went into the Einkaufsliste.
  exportedAt DateTime?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  entries    MealWeekEntry[]

  @@unique([userId, weekStart])
}

model MealWeekEntry {
  id          String   @id @default(uuid())
  weekId      String
  week        MealWeek @relation(fields: [weekId], references: [id], onDelete: Cascade)
  day         Int
  slot        String
  recipeId    String
  recipe      Recipe   @relation("WeekRecipe", fields: [recipeId], references: [id], onDelete: Cascade)
  sauceId     String?
  sauce       Recipe?  @relation("WeekSauce", fields: [sauceId], references: [id], onDelete: SetNull)
  servings    Float    @default(1)
  /// Chosen by the user – plan adaptation leaves it alone.
  isSwapped   Boolean  @default(false)
  /// Recipe id this replaced automatically (dislike, equipment, no microwave).
  adaptedFrom String?

  @@unique([weekId, day, slot])
}

/// A meal ticked off: eaten as planned, swapped for something else, or skipped.
/// Macros are copied at logging time, so later recipe edits don't rewrite history.
model MealLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Local calendar day, yyyy-MM-dd
  day       String
  /// breakfast | snack | lunch | afternoon | dinner | extra
  slot      String
  /// eaten | swapped | skipped
  status    String
  recipeId  String?
  label     String
  kcal      Float    @default(0)
  protein   Float    @default(0)
  carbs     Float    @default(0)
  fat       Float    @default(0)
  cost      Float    @default(0)
  createdAt DateTime @default(now())

  @@index([userId, day])
}

model NutritionSettings {
  id                String    @id @default(uuid())
  userId            String    @unique
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kcalTarget        Int       @default(2200)
  kcalTolerance     Int       @default(100)
  proteinMin        Int       @default(150)
  proteinMax        Int       @default(165)
  fatMin            Int       @default(60)
  fatMax            Int       @default(75)
  weeklyBudget      Float     @default(70)
  /// hofer-lidl | billa-spar | bio-markt
  store             String    @default("hofer-lidl")
  /// Weekend meals on the shopping list and in the budget (off = eaten at home with the family).
  shopWeekend       Boolean   @default(true)
  hasMicrowave      Boolean   @default(false)
  /// JSON: equipment and dislikes as string arrays, trainingDays as weekday → upper|lower|rest,
  /// reminders as kind → on/off, favorites as recipe ids. Defaults live in lib/nutrition/settings.ts.
  equipment         String    @default("[]")
  dislikes          String    @default("[]")
  trainingDays      String    @default("{}")
  trainingTime      String    @default("16:00")
  trainingMinutes   Int       @default(75)
  commuteMinutes    Int       @default(30)
  weekendBreakfast  String    @default("08:30")
  prepStartTime     String    @default("15:00")
  eveningTime       String    @default("20:00")
  checkInTime       String    @default("20:30")
  reminders         String    @default("{}")
  favorites         String    @default("[]")
  /// Meal prep start – food spending before it is the comparison baseline.
  startedAt         DateTime  @default(now())
  remindersSyncedAt DateTime?
  /// The two nutrition routines were added to Routinen once (deleting them later sticks).
  habitsSetup       Boolean   @default(false)
  /// weekStart of the last week whose goal was celebrated, so the confetti fires once.
  celebratedWeek    String?
  updatedAt         DateTime  @updatedAt
}

/// Weekly body check-in for the recomposition trend.
model BodyMetric {
  id       String @id @default(uuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// yyyy-MM-dd
  day      String
  weightKg Float?
  waistCm  Float?

  @@unique([userId, day])
}
