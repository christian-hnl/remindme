generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String          @id @default(uuid())
  email        String          @unique
  displayName  String
  preferences  String          @default("{\"theme\": \"dark\", \"currency\": \"EUR\", \"active_mode\": \"all\"}")
  createdAt    DateTime        @default(now())
  subjects     Subject[]
  tasks        Task[]
  savingsPots  SavingsPot[]
  transactions Transaction[]
  widgets      UserWidget[]
  schedule     ScheduleBlock[]
  reminders    Reminder[]
  untisConfig  WebUntisConfig?
}

model WebUntisConfig {
  id          String    @id @default(uuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  school      String    @default("gym-st-michael")
  schoolName  String    @default("Gymnasium St. Michael")
  server      String    @default("arche.webuntis.com")
  username    String    @default("alexander.student")
  password    String?
  isConnected Boolean   @default(true)
  lastSyncAt  DateTime?
  autoSync    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Subject {
  id        String          @id @default(uuid())
  userId    String?
  user      User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  untisCode String?         // z. B. 'M', 'PH', 'INF', 'BWL', 'L'
  colorHex  String          @default("#6366f1")
  icon      String          @default("book")
  createdAt DateTime        @default(now())
  tasks     Task[]
  lessons   ScheduleBlock[]
}

model Task {
  id               String         @id @default(uuid())
  userId           String?
  user             User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId        String?
  subject          Subject?       @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  scheduleBlockId  String?
  scheduleBlock    ScheduleBlock? @relation(fields: [scheduleBlockId], references: [id], onDelete: SetNull)
  title            String
  description      String?
  dueDate          DateTime
  estimatedMinutes Int            @default(30)
  priority         String         @default("medium") // 'low', 'medium', 'high', 'urgent'
  status           String         @default("backlog") // 'backlog', 'in_progress', 'done', 'archived'
  isUntisSync      Boolean        @default(false)
  customMetadata   String?        @default("{}")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model ScheduleBlock {
  id               String   @id @default(uuid())
  userId           String?
  user             User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId        String?
  subject          Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  title            String
  subjectCode      String?  // e.g. "M", "PH", "INF"
  dayOfWeek        Int      @default(1) // 1 = Monday ... 5 = Friday, 7 = Sunday
  startTime        String   // "09:00"
  endTime          String   // "11:00"
  room             String?  // e.g. "Raum 204", "Physiksaal 1"
  teacher          String?  // e.g. "Hr. Weber", "Fr. Dr. Schneider"
  colorHex         String   @default("#8B5CF6")
  isCancelled      Boolean  @default(false)
  substitutionNote String?  // e.g. "Vertretung Fr. Klein in R102"
  externalUntisId  String?
  createdAt        DateTime @default(now())
  tasks            Task[]
}

model Reminder {
  id            String   @id @default(uuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String   // e.g. "Wäsche aufhängen / rausbringen"
  category      String   @default("Haushalt") // "Haushalt", "Erledigung", "Gesundheit", "Paket"
  dueTime       String?  // e.g. "18:30"
  dueDate       DateTime @default(now())
  isDone        Boolean  @default(false)
  icon          String   @default("bell")
  priority      String   @default("medium") // "low", "medium", "high"
  repeatPattern String   @default("none") // "none", "daily", "weekly"
  createdAt     DateTime @default(now())
}

model SavingsPot {
  id                  String        @id @default(uuid())
  userId              String?
  user                User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                String
  targetAmount        Float
  currentAmount       Float         @default(0.0)
  monthlyContribution Float         @default(0.0)
  targetDate          DateTime?
  icon                String        @default("piggy-bank")
  colorHex            String        @default("#10b981")
  isArchived          Boolean       @default(false)
  createdAt           DateTime      @default(now())
  transactions        Transaction[]
}

model Transaction {
  id              String      @id @default(uuid())
  userId          String?
  user            User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  savingsPotId    String?
  savingsPot      SavingsPot? @relation(fields: [savingsPotId], references: [id], onDelete: SetNull)
  title           String
  amount          Float
  category        String
  type            String
  isRecurring     Boolean     @default(false)
  transactionDate DateTime    @default(now())
  createdAt       DateTime    @default(now())
}

model UserWidget {
  id             String   @id @default(uuid())
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  widgetKey      String
  title          String
  layoutPosition String   @default("{\"col\": 1, \"row\": 1, \"width\": 1, \"height\": 1}")
  config         String   @default("{}")
  isVisible      Boolean  @default(true)
  createdAt      DateTime @default(now())
}
