# SQLite database (path is relative to prisma/schema.prisma)
DATABASE_URL="file:./dev.db"

# Optional: protect the dashboard with HTTP Basic Auth.
# Strongly recommended as soon as the app is reachable from other devices or the internet.
# The iCal feed then requires a token, which is shown in the "Kalender abonnieren" dialog.
# APP_USERNAME="admin"
# APP_PASSWORD="ein-langes-zufaelliges-passwort"

# Optional: Enable Banking credentials (otherwise enter them in Einstellungen → Banken).
# The private key may be given with literal \n line breaks.
# ENABLE_BANKING_APP_ID="00000000-0000-0000-0000-000000000000"
# ENABLE_BANKING_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
